# Live Counter - environment
#
# Copy to `.env` (or `.env.production`) and fill in real values.
# Vite inlines VITE_* variables at BUILD time, so this must be set before
# `npm run build`, not at runtime.
# -----------------------------------------------------------------------------

# Backend base URL used to fetch live display data AND to open the Socket.IO
# realtime connection.
#
# IMPORTANT - the name is `VITE_API_URL` (not VITE_API_BASE_URL) and the value
# must be the ORIGIN only, without a trailing `/api`: the app appends
# `/api/queue/...` itself, so including `/api` would request `/api/api/queue/...`.
#
# IMPORTANT - this MUST be the same backend the Admin Panel talks to.
# Socket.IO rooms are per-backend-process, so a display that subscribes to a
# different backend than the one the Admin Panel mutates will never receive
# queue events, and the board will silently stop updating. If the Admin Panel
# points at the production API, this must point at production too.
VITE_API_URL=https://your-backend.example.com

# Optional. Only needed when the Socket.IO endpoint differs from VITE_API_URL.
# VITE_SOCKET_URL=https://your-backend.example.com

# Optional. Facility the board opens on when the page is loaded WITHOUT a
# `centerId` query parameter.
#
# MUST be the real persisted MongoDB _id of the service center (the value
# returned by POST /api/service-centers), never its name. An explicit
# `/live-counter?centerId=<id>` in the URL always takes precedence, so one
# build can serve several screens.
# VITE_DEFAULT_CENTER_ID=000000000000000000000000

# Base URL of the deployed Customer Web app. This is the single source of truth
# for the canonical customer queue QR that the display encodes:
#
#   https://<this-host>/join?centerId=<CENTER_ID>[&serviceId=<SERVICE_ID>]
#
# Requirements for a production value:
#   * must be `https://`
#   * must be a real DNS name - NOT localhost, NOT a bare IP address
#   * must be the same host that serves /.well-known/assetlinks.json
#     (Android App Link) and /.well-known/apple-app-site-association
#     (iOS Universal Link)
#   * must match --dart-define=QUEUEFLOW_JOIN_HOSTS in the Flutter build
#
# A missing or non-public value is not silently ignored: the display renders a
# "Customer Web URL is not publicly reachable" warning above the QR, because a
# QR pointing at localhost is unscannable by a customer standing at the screen.
VITE_CUSTOMER_WEB_URL=https://join.example.com
