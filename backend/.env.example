# ==============================================================================
# QueueFlow — Environment Configuration Template (.env.example)
#
# NOTE: This file contains template placeholders only. DO NOT commit real secrets.
# In PRODUCTION (NODE_ENV=production), QueueFlow enforces strict entropy and rejects
# known template placeholder strings (such as "your_super_secret...").
# ==============================================================================

# ─── Environment & Server ─────────────────────────────────────────────────────
# Allowed values: development | test | production
NODE_ENV=development
PORT=5000

# ─── Database (MongoDB Atlas) ──────────────────────────────────────────────────
# Required in ALL environments.
# Scheme must start with mongodb:// or mongodb+srv://
# Replace template tokens <username>, <password>, and <cluster> with actual credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/queueflow?retryWrites=true&w=majority

# ─── Authentication & JWT ─────────────────────────────────────────────────────
# In PRODUCTION: Strictly required, minimum 32 characters (prefer 64).
# Example command to generate a cryptographically strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_secure_random_hex_string_min_32_chars
JWT_EXPIRES_IN=7d

# ─── QR Code Cryptographic Security (HMAC-SHA256) ─────────────────────────────
# In PRODUCTION: Strictly required, minimum 32 characters.
# MUST BE CRYPTOGRAPHICALLY DISTINCT FROM JWT_SECRET.
# Example command to generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this secret invalidates existing QR codes.
QR_SIGNING_SECRET=replace_with_a_separate_cryptographically_secure_random_hex_string

# ─── IoT Device Authentication ────────────────────────────────────────────────
# In PRODUCTION: Strictly required, minimum 16 characters.
# Shared secret for physical sensors, footfall cameras, and scanner kiosks.
IOT_SECRET=replace_with_a_secure_random_iot_device_shared_secret

# ─── CORS (Allowed Web Origins) ───────────────────────────────────────────────
# Comma-separated list of trusted web origins.
# In PRODUCTION: Wildcard ('*') is prohibited. Each origin must start with http:// or https://.
# In DEVELOPMENT: Localhost origins (http://localhost:5173, etc.) are included automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Redis (Distributed Rate Limiting & Horizontal Scaling) ───────────────────
#
# [DEVELOPMENT / TEST ENVIRONMENT]
# Redis is optional. If unconfigured or disabled, QueueFlow safely falls back
# to local in-memory rate limiting and single-node socket adapter.
# REDIS_ENABLED=false
#
# [PRODUCTION ENVIRONMENT (NODE_ENV=production)]
# Redis is STRICTLY MANDATORY. In-memory fallback is blocked by design to prevent
# rate-limit bypass and broken Socket.IO synchronization across multiple Render instances.
# Startup will halt immediately if Redis is missing, disabled, or unreachable.
# Provide full URL (Render Redis / Redis Cloud / Upstash):
# REDIS_URL=redis://default:<password>@<host>:<port>
# Or discrete parameters:
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── Developer Tools ──────────────────────────────────────────────────────────
# Strictly prohibited and ignored when NODE_ENV=production.
# Only enabled when explicitly set to 'true' in development.
DEV_SIMULATOR_ENABLED=true

# ─── Multi-Channel Token Intake (Phase D) ────────────────────────────────────
# External intake channels (WhatsApp, SMS, Telegram). Leave disabled or empty if unconfigured.
# Never hardcode production API credentials. Real tokens must reside only in .env or deployment vault.

# WhatsApp (Meta WhatsApp Cloud API / Twilio WhatsApp)
WHATSAPP_ENABLED=false
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# SMS (Twilio / Telco Webhooks)
SMS_ENABLED=false
SMS_PROVIDER=twilio
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
# SMS_FROM_NUMBER=
# SMS_WEBHOOK_SECRET=

# Telegram (Telegram Bot API)
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

