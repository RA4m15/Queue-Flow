# Backend API and Socket.IO URLs (Production Render deployment)
VITE_API_URL=https://queue-flow-4308.onrender.com
VITE_SOCKET_URL=https://queue-flow-4308.onrender.com

# Optional. Facility the dashboard opens on when the administrator has not
# chosen one yet.
#
# MUST be the real persisted MongoDB _id of the service center (the value
# returned by POST /api/service-centers), never its name. An administrator's
# manual selection always takes precedence and is remembered in localStorage,
# so this never overrides a deliberate choice.
#
# The id is validated against the live center list on every load, so a stale or
# removed id simply falls back to the first available center.
# VITE_DEFAULT_CENTER_ID=000000000000000000000000
